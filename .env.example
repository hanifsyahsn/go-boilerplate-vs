# development keeps gin in debug mode (route list on stdout); anything else
# (production, staging, …) runs gin in release mode.
ENVIRONMENT=development
SERVER_ADDRESS=:8080

# Database. DB_SOURCE is what the app uses (inside docker compose the host is
# `postgres`); DB_SOURCE_LOCAL is for `make migrate_*` from the host.
DB_DRIVER=postgres
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=go_boilerplate_vs_db
DB_PORT=5432
DB_LOCAL_PORT=5433
DB_SOURCE=postgresql://postgres:postgres@localhost:5433/go_boilerplate_vs_db?sslmode=disable
DB_SOURCE_LOCAL=postgresql://postgres:postgres@localhost:5433/go_boilerplate_vs_db?sslmode=disable

# JWT (ES256). Generate the keys with `make ec_private && make ec_public`.
ACCESS_TOKEN_DURATION=15m
# Refresh tokens rotate on every refresh, so this is the idle timeout
# (optional, default 168h = 7 days).
REFRESH_TOKEN_DURATION=168h
# A login without trust_device ends this long after it, refresh or not
# (optional, default 168h). A trusted device slides with no cap.
UNTRUSTED_SESSION_DURATION=168h
TOKEN_ISSUER=go_boilerplate_vs
CLIENT_ID=go_boilerplate_vs_web
EC_PRIVATE_KEY_PATH=./internal/platform/config/ec-private.pem
EC_PUBLIC_KEY_PATH=./internal/platform/config/ec-public.pem

# Auth cookies (optional). COOKIE_SECURE defaults to true; false for plain-HTTP local dev.
COOKIE_SECURE=false
COOKIE_DOMAIN=

# Logging (optional). LOG_FORMAT: text (default) or json (use json in production);
# LOG_LEVEL: debug, info (default), warn or error.
LOG_FORMAT=text
LOG_LEVEL=info

# Reverse proxies (optional) whose X-Forwarded-For / X-Real-IP set the client IP
# (the per-IP auth rate limit, the access log): comma-separated IPs or CIDRs.
# Empty trusts none, so the client IP is the connection's address. Behind a proxy
# (nginx, a load balancer) list it here, or every client shares the proxy's IP
# and one busy office can use up the auth limit for everyone.
TRUSTED_PROXIES=

# Browser origins (optional) allowed to call the API with the auth cookies, for
# CORS and the origin guard: comma-separated scheme://host[:port], e.g.
# https://app.example.com,http://localhost:5173. Empty = both off (a warning at
# start): only same-origin pages can use the API.
ALLOWED_ORIGINS=

# Outgoing email (password reset, email verification). Port 465 = implicit TLS,
# any other port requires STARTTLS (never plain text). SMTP_HOST and SMTP_FROM
# are required except with ENVIRONMENT=development, where an empty SMTP_HOST
# logs each email (subject at info, body at debug) instead of sending it.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# The front end's base URL, no trailing / — the links in emails are built on it
# (APP_BASE_URL + "/reset-password?token=…"). Required.
APP_BASE_URL=http://localhost:5173

# API activity log (one row per request): how long rows are kept, a Go duration
# (optional, default 17520h = 2 years; 0 keeps them forever).
ACTIVITY_LOG_RETENTION=17520h
